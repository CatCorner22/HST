# One credential path is enough.
#
# 1. An API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
#
# 2. Or run `ant auth login` and set nothing here — the SDK finds the profile
#    on disk by itself.

# Optional overrides.
# GONZO_MODEL=claude-opus-5          # main generation model
# GONZO_JUDGE_MODEL=claude-sonnet-5  # cheaper model for the rubric pass

# The wire: live web search, off by default. Each search is billed by the API
# ($10 per 1,000 as of 2026) on top of token cost. With the wire on, the
# narrator checks current facts, cites its sources, and stops disclaiming its
# knowledge cutoff for anything it can look up.
# GONZO_WIRE=1                       # turn the wire on by default (CLI --wire/--no-wire overrides)
# GONZO_WIRE_MAX_SEARCHES=3          # searches allowed per request
# GONZO_WIRE_TOOL=web_search_20250305  # server tool version, if you track a newer one
